{
  "name": "etsy-store-fastpass",
  "version": "1.0.0",
  "description": "Automation tool to quickly add products to Etsy shops using the Etsy API",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "auth": "tsx src/auth.ts",
    "add-product": "tsx src/addProduct.ts",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "etsy",
    "automation",
    "api",
    "oauth",
    "ecommerce"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.2",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "open": "^10.0.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
