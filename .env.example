# Etsy API Credentials
# Get these from https://www.etsy.com/developers/your-apps
ETSY_API_KEY=your_keystring_here
ETSY_API_SECRET=your_shared_secret_here

# OAuth Configuration
REDIRECT_URI=http://localhost:3000/oauth/callback
PORT=3000

# Shop Configuration
ETSY_SHOP_ID=your_shop_id_here

# Token Storage (will be auto-generated after authentication)
ACCESS_TOKEN=
REFRESH_TOKEN=
